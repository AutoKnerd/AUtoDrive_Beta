{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "autoshopcx.com"
        }
      ],
      "destination": "https://app.autodrivecx.com/tools",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.autoshopcx.com"
        }
      ],
      "destination": "https://app.autodrivecx.com/tools",
      "permanent": true
    }
  ]
}
